# Anthropic API Key (required for Claude AI chat feature)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Ralph default configuration
RALPH_DEFAULT_TOOL=claude
RALPH_MAX_ITERATIONS=10

# PRD and progress file paths are automatically resolved relative to project root
# No need to set these unless you want to use custom locations
# PRD_FILE_PATH=./prd.json
# PROGRESS_FILE_PATH=./scripts/ralph/progress.txt
